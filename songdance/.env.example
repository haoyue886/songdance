NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
SONGDANCE_ENVIRONMENT=development
SONGDANCE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
SONGDANCE_REDIS_URL=redis://localhost:6379/0
SONGDANCE_QUEUE_NAME=songdance
SONGDANCE_QUOTA_BACKEND=redis
SONGDANCE_QUOTA_NAMESPACE=songdance
SONGDANCE_DATABASE_URL=postgresql+psycopg://songdance:local-only@localhost:5432/songdance
SONGDANCE_STORAGE_BACKEND=s3
SONGDANCE_LOCAL_STORAGE_PATH=.data/storage
SONGDANCE_TEMP_PATH=.data/tmp
SONGDANCE_S3_ENDPOINT_URL=http://localhost:9000
SONGDANCE_S3_REGION=us-east-1
SONGDANCE_S3_BUCKET=songdance
SONGDANCE_S3_ACCESS_KEY=songdance
SONGDANCE_S3_SECRET_KEY=replace-me
SONGDANCE_AUTO_CREATE_SCHEMA=false
# Exact proxy count from the public edge to the API container; block direct public API access when non-zero.
SONGDANCE_TRUSTED_PROXY_HOPS=0
SONGDANCE_TRUSTED_PROXY_CIDRS=
SONGDANCE_MAX_REQUEST_BYTES=27262976
SONGDANCE_HOURLY_JOB_LIMIT=3
SONGDANCE_CLIENT_ACTIVE_JOB_LIMIT=1
SONGDANCE_GLOBAL_ACTIVE_JOB_LIMIT=8
SONGDANCE_DAILY_JOB_LIMIT=100
SONGDANCE_ANALYTICS_JOB_EVENT_LIMIT_PER_MINUTE=10
SONGDANCE_ANALYTICS_CLIENT_EVENT_LIMIT_PER_MINUTE=30
SONGDANCE_ANALYTICS_GLOBAL_EVENT_LIMIT_PER_MINUTE=1000
SONGDANCE_ANALYTICS_DAILY_EVENT_LIMIT=10000
SONGDANCE_QUOTA_ACTIVE_TTL_SECONDS=86400
SONGDANCE_DOWNLOAD_URL_TTL_SECONDS=300
SONGDANCE_DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
SONGDANCE_CLEANUP_INTERVAL_SECONDS=900
SONGDANCE_CLEANUP_BATCH_SIZE=100
SONGDANCE_TEMP_FILE_TTL_SECONDS=86400
SONGDANCE_UPLOAD_INTENT_TIMEOUT_SECONDS=900
SONGDANCE_MODEL_ONSET_THRESHOLD=0.5
SONGDANCE_MODEL_FRAME_THRESHOLD=0.3
SONGDANCE_CLEANUP_MIN_CONFIDENCE=0.1
SONGDANCE_CLEANUP_MIN_DURATION_SECONDS=0.04
SONGDANCE_CLEANUP_ADJACENT_SAME_PITCH_GAP_SECONDS=0.03
SONGDANCE_CLEANUP_MAX_NOTE_DURATION_SECONDS=30
SONGDANCE_ANALYSIS_ENABLED=true
SONGDANCE_ANALYSIS_SAMPLE_RATE=22050
SONGDANCE_ANALYSIS_HOP_LENGTH=512
SONGDANCE_ANALYSIS_MIN_TEMPO_CONFIDENCE=0.2
SONGDANCE_ANALYSIS_MIN_METER_CONFIDENCE=0.6
SONGDANCE_ANALYSIS_MIN_KEY_CONFIDENCE=0.18
SONGDANCE_ANALYSIS_TIMEOUT_SECONDS=15
SONGDANCE_YOUTUBE_ENABLED=false
SONGDANCE_YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=120
