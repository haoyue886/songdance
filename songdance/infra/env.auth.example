# Phase 38.0 proposed configuration contract; not wired into current runtime.
# Never commit a populated copy. Do not paste values into chat or test reports.
# Production site and API origins; local http://localhost is allowed only in development/test.
SONGDANCE_ENVIRONMENT=production
NEXT_PUBLIC_SITE_URL=
SONGDANCE_AUTH_API_URL=

# Next.js server + FastAPI only. The frontend receives only short-lived access JWTs.
# Use the project's modern sb_publishable_ key, not service_role or sb_secret_.
SONGDANCE_SUPABASE_URL=
SONGDANCE_SUPABASE_PUBLISHABLE_KEY=

# FastAPI only: separate, least-privilege Supabase session lookup connection.
# Require TLS in production. Never use the general postgres/admin password here.
# Query options are limited to sslmode, sslrootcert, connect_timeout and application_name.
# Do not override user/password/host/dbname or use a libpq service in query parameters.
SONGDANCE_AUTH_SESSION_DATABASE_URL=

# Google OAuth secret and SMTP credentials belong in the Supabase dashboard.
# Configure the site's /api/auth/callback allowlist and Email OTP expiry = 600 seconds.
# No service_role/admin signing secret is needed by the browser.
