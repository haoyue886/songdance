# Phase 38.1 local implementation. Leave disabled until the target environment is verified.
# Never commit a populated copy. Do not paste values into chat or test reports.
# Production site and API origins; local http://localhost is allowed only in development/test.
SONGDANCE_ENVIRONMENT=production
SONGDANCE_AUTH_ENABLED=false
# Next.js build-time flag: changing this requires rebuilding the Web.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=
SONGDANCE_AUTH_API_URL=

# Next.js server + FastAPI: independent random 32-128 char base64url/hex secret.
# For example, generate locally with openssl rand -hex 32; do not commit the result.
SONGDANCE_AUTH_BRIDGE_SECRET=

# Next.js server + FastAPI only. The frontend receives only short-lived access JWTs.
# Use the project's modern sb_publishable_ key, not service_role or sb_secret_.
SONGDANCE_SUPABASE_URL=
SONGDANCE_SUPABASE_PUBLISHABLE_KEY=

# FastAPI only: separate, least-privilege Supabase session lookup connection.
# Require TLS in production. Never use the general postgres/admin password here.
# Query options are limited to sslmode, sslrootcert, connect_timeout and application_name.
# Do not override user/password/host/dbname or use a libpq service in query parameters.
SONGDANCE_AUTH_SESSION_DATABASE_URL=
# Use songdance_auth with supabase-session-reader-views.sql when the provider
# prevents granting USAGE on auth; auth preserves the original direct-reader setup.
SONGDANCE_AUTH_SESSION_SCHEMA=auth
SONGDANCE_AUTH_SESSION_MAX_AGE_SECONDS=0
SONGDANCE_AUTH_SESSION_IDLE_SECONDS=0
# Match provider time-box/inactivity settings before enabling them; zero means disabled.
# API uses Redis for shared OTP budgets and serialized/encrypted refresh caching.
# Do not copy identity/bridge/session-lookup credentials to Worker/Cleanup services.
SONGDANCE_USAGE_ENABLED=false
SONGDANCE_RELIABLE_QUEUE_ENABLED=false
SONGDANCE_GUEST_USAGE_ENABLED=false
SONGDANCE_ACCOUNT_DELETION_ENABLED=false
# Requires migration 013 plus auth/usage/reliable queue. A dedicated deletion worker
# confirms billing before erasing local tasks/email; retain identity and financial tombstones.
# Worker: python -m app.jobs.account_deletion --loop
# API only: independent random secret, >=32 chars; requires migration 011 plus auth/usage/outbox.
# Preserve across replicas/restarts and while draining old submissions. Never log or expose it.
SONGDANCE_GUEST_SIGNING_SECRET=
SONGDANCE_DISPATCH_WAIT_SECONDS=900
# Enable only after migration 010 and a dedicated `python -m app.jobs.dispatch --loop` service.
SONGDANCE_FREE_MONTHLY_JOB_LIMIT=1
SONGDANCE_PAID_USAGE_ENABLED=false
SONGDANCE_PAID_IP_HOURLY_JOB_LIMIT=60
SONGDANCE_BILLING_ENVIRONMENT=test
# Local paid-period projection; Creem Test adapter settings are in env.creem.example.
# Production paid usage rejects test entitlements; all clip limits remain <=90s.

# Google OAuth secret belongs in the Supabase dashboard.
# Resend test-only local adapter/config: env.mail.example; actual setup/testing is still pending.
# Keep mail credentials server-only; do not enable both Hook and SMTP sending.
# Configure the site's /api/auth/callback allowlist and Email OTP expiry = 600 seconds.
# No service_role/admin signing secret is needed by the browser.
