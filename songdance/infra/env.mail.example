# Default-off TEST ONLY. Copy into private environment configuration, never commit filled values.
# Requires migration 014. Do not turn on Supabase Hook before this endpoint is deployed/tested.
SONGDANCE_MAIL_ENABLED=false
SONGDANCE_MAIL_PROJECT_REF=
# Must match SONGDANCE_SUPABASE_URL and exact CORS origin/NEXT_PUBLIC_SITE_URL.
SONGDANCE_MAIL_SITE_URL=
SONGDANCE_MAIL_FROM=auth@mail.notavue.io
# Comma-separated list of 1-10 explicitly authorized test mailboxes. No general recipients yet.
SONGDANCE_MAIL_TEST_RECIPIENTS=
SONGDANCE_SUPPORT_EMAIL=
# Set true only AFTER receiving/reply testing succeeds; current support target is pending creation.
SONGDANCE_MAIL_SUPPORT_VERIFIED=false
# Resend domain-scoped, sending-only key; no Full Access needed.
SONGDANCE_RESEND_API_KEY=
# Supabase: v1,whsec_<base64>; Resend: whsec_<base64>. Independent provider secrets.
SONGDANCE_SUPABASE_EMAIL_HOOK_SECRET=
SONGDANCE_RESEND_WEBHOOK_SECRET=
# Separate random 32+ character server-only HMAC key; keep stable across replicas/restarts.
# Changing this key requires a reviewed migration of digests/suppressions; do not simply rotate.
SONGDANCE_MAIL_DIGEST_SECRET=
