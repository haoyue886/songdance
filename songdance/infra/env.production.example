# Vercel Web
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Shared by Railway API, Worker and Cleanup services
SONGDANCE_ENVIRONMENT=production
SONGDANCE_CORS_ORIGINS=https://www.example.com
SONGDANCE_DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_POSTGRES_HOST:5432/DATABASE
SONGDANCE_REDIS_URL=redis://PRIVATE_REDIS_HOST:6379/0
SONGDANCE_QUEUE_NAME=songdance
SONGDANCE_QUOTA_BACKEND=redis
SONGDANCE_QUOTA_NAMESPACE=production

# Private S3-compatible storage; Cloudflare R2 is one option
SONGDANCE_STORAGE_BACKEND=s3
SONGDANCE_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
SONGDANCE_S3_REGION=auto
SONGDANCE_S3_BUCKET=songdance-production
SONGDANCE_S3_ACCESS_KEY=replace-in-host-dashboard
SONGDANCE_S3_SECRET_KEY=replace-in-host-dashboard
SONGDANCE_TEMP_PATH=/tmp/songdance

# Replace this reserved documentation range with the exact Railway edge peer CIDR
# before deployment. The API intentionally rejects /0 default routes in production.
SONGDANCE_TRUSTED_PROXY_HOPS=1
SONGDANCE_TRUSTED_PROXY_CIDRS=192.0.2.0/24

SONGDANCE_AUTO_CREATE_SCHEMA=false
SONGDANCE_MAX_REQUEST_BYTES=27262976
SONGDANCE_HOURLY_JOB_LIMIT=3
SONGDANCE_CLIENT_ACTIVE_JOB_LIMIT=1
SONGDANCE_GLOBAL_ACTIVE_JOB_LIMIT=2
SONGDANCE_DAILY_JOB_LIMIT=25
SONGDANCE_ANALYTICS_JOB_EVENT_LIMIT_PER_MINUTE=10
SONGDANCE_ANALYTICS_CLIENT_EVENT_LIMIT_PER_MINUTE=30
SONGDANCE_ANALYTICS_GLOBAL_EVENT_LIMIT_PER_MINUTE=1000
SONGDANCE_ANALYTICS_DAILY_EVENT_LIMIT=10000
SONGDANCE_QUOTA_ACTIVE_TTL_SECONDS=86400
SONGDANCE_DOWNLOAD_URL_TTL_SECONDS=300
SONGDANCE_DOWNLOAD_SIGNING_SECRET=generate-a-unique-random-value-of-at-least-32-characters
SONGDANCE_CLEANUP_INTERVAL_SECONDS=900
SONGDANCE_CLEANUP_BATCH_SIZE=100
SONGDANCE_TEMP_FILE_TTL_SECONDS=86400
SONGDANCE_UPLOAD_INTENT_TIMEOUT_SECONDS=900

# Keep disabled until legal review for the target operating region is complete.
SONGDANCE_YOUTUBE_ENABLED=false
SONGDANCE_YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=120
